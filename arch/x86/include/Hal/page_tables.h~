/**
 * HalMakeL1PTE - make a L1 PTE.
 * @addr: physical address of memory
 * @flags: PTE flags
 */
static inline L1PTE HalMakeL1PTE(unsigned long addr, PTEFLAGS flags)
{
	return { addr | flags | __PG_GLOBAL };
}

/**
 * HalMakeL2PTE - make a L2 PTE.
 * @addr: physical address of memory
 * @flags: PTE flags
 */
static inline L2PTE HalMakeL2PTE(unsigned long addr, PTEFLAGS flags)
{
	if (flags & __PG_PAT)
		flags |= __PG_PAT_HUGE;
	else
		flags |= __PG_HUGE;
	return { addr | flags | __PG_GLOBAL };
}

/**
 * HalMakeL3PTE - make a L3 PTE.
 * @addr: physical address of memory
 * @flags: PTE flags
