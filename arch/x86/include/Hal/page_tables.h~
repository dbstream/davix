/**
 * HalL1PTEOffset - get the level 1 page table offset of an address.
 * @addr: virtual address
 */
static inline int HalL1PTEOffset(unsigned long addr)
{
	return (addr >> HalL1PTEShift()) & HalL1PTEMask();
}

