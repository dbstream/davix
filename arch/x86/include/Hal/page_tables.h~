/**
 * HalL1PTEAddrEnd - get the next level 1 PTE address boundary or end address.
 * @addr: virtual address
 * @end: end virtual address
 */
static inline unsigned long HalL1PTEAddrEnd(unsigned long addr, unsigned long end)
{
	unsigned long entry_size = 1UL << HalL1PTEShift();
	unsigned long next = (addr + entry_size) & ~(entry_size - 1);
	if (end < next || next < addr)
		return end;
	else
		return next;
}

